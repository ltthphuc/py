{
  "rules": {
    ".read": false,
    ".write": false,

    "teachers": {
      ".read": false,
      ".write": false
    },

    "rooms": {
      "$room": {
        ".read":  "auth != null && root.child('teachers').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('teachers').child(auth.uid).val() === true",

        "meta": {
          ".read": "auth != null"
        },

        "students": {
          "$sid": {
            ".read":  "auth != null && auth.uid === $sid",
            ".write": "auth != null && auth.uid === $sid && root.child('rooms').child($room).child('meta').exists()",
            "code": { ".validate": "newData.isString() && newData.val().length <= 100000" },
            "segs": { ".validate": "newData.isString() && newData.val().length <= 16000" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "lop":  { ".validate": "newData.isString() && newData.val().length <= 60" },
            "may":  { ".validate": "newData.isString() && newData.val().length <= 60" },
            "bai":  { ".validate": "newData.isString() && newData.val().length <= 60" }
          }
        },

        "ctl": {
          "$sid": {
            ".read": "auth != null && auth.uid === $sid"
          }
        },

        "cmd": {
          "$sid": {
            ".read":  "auth != null && auth.uid === $sid",
            ".write": "auth != null && auth.uid === $sid && !newData.exists()"
          }
        },

        "files": {
          ".read": "auth != null"
        },

        "filedata": {
          "$id": {
            ".read": "auth != null"
          }
        },

        "subs": {
          "$sid": {
            ".write": "auth != null && auth.uid === $sid && root.child('rooms').child($room).child('meta').exists()",
            "$key": {
              ".validate": "newData.hasChildren(['code', 'name', 'bai']) && newData.child('code').isString() && newData.child('code').val().length <= 100000"
            }
          }
        }
      }
    }
  }
}
